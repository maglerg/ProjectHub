# Создай рядом файл .env и укажи в нём собственные секреты.
# Не публикуй .env в Git и не добавляй его в Docker-образы.

# Пароль пользователя PostgreSQL. Используй длинный случайный пароль.
DB_PASSWORD=replace-with-a-strong-database-password

# Случайный секрет JWT, минимум 32 байта.
# Пример генерации в PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-bytes
